# BeforeBell local/server configuration
#
# Never commit real credentials.
# Hosted AWS environments should use IAM roles rather than AWS_PROFILE.

BEFOREBELL_AWS_REGION=us-east-1
BEFOREBELL_DYNAMODB_TABLE=beforebell-dev

# Replace with your own deployed AgentCore runtime ARN.
BEFOREBELL_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/RUNTIME_ID

# Fixed-purpose synthetic demo mutations.
BEFOREBELL_ENABLE_DEMO_MUTATIONS=false